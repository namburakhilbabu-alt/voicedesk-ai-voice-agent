# Copy this file to .env and fill in what you have:   cp .env.example .env
# Only ANTHROPIC_API_KEY is required. Everything else switches on an extra feature.

# --- Required: the AI (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Voice input in the browser call (console.groq.com → API Keys, free) ---
GROQ_API_KEY=

# --- Booking confirmation emails (Google Account → Security → App passwords) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Owner alerts on your phone (Telegram: message @BotFather → /newbot) ---
# Chat ID: send your bot any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# interesting = only calls worth the owner's time | all = every call
OWNER_ALERTS=interesting

# --- Real phone calls (twilio.com → Console) ---
# PUBLIC_URL: the cloudflared address when running locally, or https://<user>-<space>.hf.space on Hugging Face
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_URL=
TWILIO_VOICE=Polly.Kajal-Neural
TWILIO_LANGUAGE=en-IN

# --- Demo safety limits (they cap what visitors can spend on your keys) ---
# Comma-separated numbers the app may call; empty = anyone (Twilio trial accounts only call verified numbers anyway)
ALLOWED_PHONE_NUMBERS=
MAX_BROWSER_CALLS_PER_DAY=30
MAX_BROWSER_CALLS_PER_VISITOR=3
MAX_PHONE_CALLS_PER_DAY=10
MAX_PHONE_CALLS_PER_VISITOR=2
MAX_CALLS_PER_NUMBER=2
MAX_CALL_SECONDS=240
MAX_TURNS_PER_CALL=12
MAX_MESSAGE_CHARS=500
MAX_EMAILS_PER_HOUR=5

# --- Business ---
BUSINESS_NAME=Smile Dental Clinic
AGENT_NAME=Aria
TIMEZONE=Asia/Kolkata
TTS_VOICE=en-IN-NeerjaNeural

# --- Server ---
PORT=7860
